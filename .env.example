# =====================================================================
#  WebCrawler SaaS — configuration (copiée en .env par deploy.sh)
#  deploy.sh remplit automatiquement SECRET_KEY, DB_PASSWORD, SERVER_IP
#  et ALLOWED_HOSTS lors du premier lancement.
# =====================================================================

# --- Accès -----------------------------------------------------------
# IP du serveur sur le réseau (auto-détectée si vide)
SERVER_IP=
# Noms/IP acceptés par Django, séparés par des virgules (auto si vide)
ALLOWED_HOSTS=
# Rendre ce site « default_server » de nginx (répond à toute IP/nom inconnu).
# À laisser à False si d'autres sites tournent déjà sur le nginx du serveur.
NGINX_DEFAULT_SERVER=False
# Port local de Gunicorn (127.0.0.1 uniquement, jamais exposé au réseau)
APP_PORT=8000

# --- Django ----------------------------------------------------------
SECRET_KEY=CHANGE_ME
DEBUG=False
# Le jour où un certificat TLS est posé : HTTPS_ENABLED=True + CSRF_TRUSTED_ORIGINS=https://...
HTTPS_ENABLED=False
CSRF_TRUSTED_ORIGINS=

# --- Base de données (conteneur PostgreSQL) --------------------------
DB_NAME=webcrawler
DB_USER=webcrawler
DB_PASSWORD=CHANGE_ME

# --- Limites de crawl ------------------------------------------------
MAX_URLS_PER_TASK=25
MAX_ACTIVE_TASKS_PER_USER=5
CRAWL_DELAY=2
CRAWL_TIMEOUT_SECONDS=900
RESULT_RETENTION_DAYS=30
ALLOWED_TARGET_PORTS=80,443,8080,8443
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- Ressources (serveur Xeon : à ajuster selon cœurs/RAM) -----------
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=4
WORKER_MEM_LIMIT=2g

# --- Superutilisateur créé au 1er démarrage (optionnel) --------------
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
