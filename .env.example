# =====================================================================
#  WebCrawler SaaS — Variables d'environnement
#  Copie ce fichier en .env puis adapte les valeurs.
#  Le script deploy.sh génère automatiquement SECRET_KEY si absent.
# =====================================================================

# --- Django ---
SECRET_KEY=CHANGE_ME
DEBUG=False
# Domaine(s) autorisé(s), séparés par des virgules (ex: webcrawler-saas.fr,www.webcrawler-saas.fr)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines de confiance pour le CSRF en HTTPS (ex: https://webcrawler-saas.fr)
CSRF_TRUSTED_ORIGINS=

# --- Base de données (PostgreSQL en production) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=webcrawler
DB_USER=webcrawler
DB_PASSWORD=CHANGE_ME_AUSSI
DB_HOST=db
DB_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Limites de crawl (cahier des charges) ---
MAX_URLS_PER_TASK=25
CRAWL_DELAY=2

# --- Réglages serveur ---
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=2

# --- Superutilisateur créé automatiquement au 1er démarrage (optionnel) ---
# Laisse vide pour ne PAS créer de compte admin automatiquement.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Sécurité HTTPS (à activer une fois le certificat TLS en place) ---
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
